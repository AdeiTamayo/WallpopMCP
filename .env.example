# Wallapop account (optional, only needed for favorites / saved searches)
# IMPORTANT: wrap values in single quotes if they contain '#' (dotenv treats an
# unquoted '#' as the start of a comment and silently truncates the value).
WALLAPOP_EMAIL=
WALLAPOP_PASSWORD=

# Legacy automatic API login on every authenticated call (0/1). Off by default:
# Wallapop removed that endpoint and the real login (Keycloak) sends an SMS code.
# Use the login_start / login_submit_code tools instead.
WALLAPOP_AUTO_LOGIN=0

# Optional: import cookies exported from a logged-in browser (JSON array of cookies)
WALLAPOP_COOKIES_FILE=

# Default search location (Barcelona center by default)
WALLAPOP_DEFAULT_LAT=41.3829
WALLAPOP_DEFAULT_LNG=2.1774
WALLAPOP_DEFAULT_DISTANCE_KM=50

# Session persistence (tokens/cookies are written here after login)
WALLAPOP_SESSION_FILE=./wallapop-session.json

# Min delay between API requests in ms (be polite)
WALLAPOP_RATE_DELAY_MS=600

# Max results cap for search tools (1-200)
WALLAPOP_MAX_RESULTS=200

# Offer guard: your pickup location + radius (km). make_offer blocks listings
# that are only sold in person and outside this radius.
WALLAPOP_PICKUP_LAT=41.3829
WALLAPOP_PICKUP_LNG=2.1774
WALLAPOP_PICKUP_RADIUS_KM=8

# Estimated Wallapop costs added on top of the offer price (used to report
# the real total before you commit): Protection ~8% + shipping ~3 EUR.
WALLAPOP_PROTECTION_PCT=8
WALLAPOP_SHIPPING_FEE_EUR=3

# Browser fallback: auto | chrome | msedge | chromium | off
WALLAPOP_BROWSER=auto

# Persistent Chrome profile used by the browser fallback and the login flow
# (default: "wallapop-browser" next to WALLAPOP_SESSION_FILE). Use an absolute path.
WALLAPOP_BROWSER_PROFILE=
