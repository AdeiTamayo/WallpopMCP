# Wallapop account (optional, only needed for favorites / saved searches)
WALLAPOP_EMAIL=
WALLAPOP_PASSWORD=

# Optional: import cookies exported from a logged-in browser (JSON array of cookies)
WALLAPOP_COOKIES_FILE=

# Default search location (Barcelona center by default)
WALLAPOP_DEFAULT_LAT=41.3829
WALLAPOP_DEFAULT_LNG=2.1774
WALLAPOP_DEFAULT_DISTANCE_KM=50

# Session persistence (tokens/cookies are written here after login)
WALLAPOP_SESSION_FILE=./wallapop-session.json

# Min delay between API requests in ms (be polite)
WALLAPOP_RATE_DELAY_MS=600

# Max results cap for search tools (1-200)
WALLAPOP_MAX_RESULTS=200

# Browser fallback: auto | chrome | msedge | chromium | off
WALLAPOP_BROWSER=auto